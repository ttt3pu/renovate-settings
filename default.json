{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinDependencies",
    ":pinDevDependencies",
    "schedule:daily",
    "helpers:pinGitHubActionDigests",
    "abandonments:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "prHourlyLimit": 0,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "matchUpdateTypes": ["pin", "lockFileMaintenance", "replacement"],
      "minimumReleaseAge": null
    },
    {
      "matchPackageNames": ["actions/checkout", "actions/setup-node", "pnpm/action-setup"],
      "automerge": true
    },
    {
      "description": "Individual automerge for safe minor/patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@cloudflare/vitest-pool-workers",
        "@faker-js/faker",
        "@next/eslint-plugin-next",
        "@nuxt/eslint",
        "@nuxtjs/stylelint-module",
        "@types/*",
        "@eslint/*",
        "eslint",
        "eslint-config-next",
        "eslint-config-prettier",
        "eslint-plugin-react-hooks",
        "eslint-plugin-react-refresh",
        "http-server",
        "netlify-cli",
        "node.js",
        "node",
        "pnpm",
        "prettier",
        "renovate",
        "stylelint",
        "stylelint-scss",
        "typescript",
        "typescript-eslint",
        "ts-node",
        "tsx",
        "vitest",
        "vue-tsc",
        "zenn-cli"
      ],
      "automerge": true
    },
    {
      "groupName": "nuxt",
      "matchPackageNames": ["nuxt", "nuxt-typed-router"]
    },
    {
      "groupName": "css related packages",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["sass", "autoprefixer", "postcss", "tailwindcss", "@tailwindcss/postcss"]
    }
  ]
}
